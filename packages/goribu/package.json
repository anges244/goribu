{
  "name": "goribu",
  "version": "0.7.1",
  "description": "A full-stack React framework for Cloudflare Workers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anges244/goribu.git",
    "directory": "packages/goribu"
  },
  "homepage": "https://goribu-site.aggelos-gesoulis.workers.dev",
  "bugs": "https://github.com/anges244/goribu/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./server": {
      "default": "./src/server.js"
    },
    "./client": {
      "default": "./src/client.js"
    },
    "./vite": {
      "default": "./src/vite.js"
    }
  },
  "bin": {
    "goribu": "./bin/goribu.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "dependencies": {
    "@babel/parser": "^7.29.2",
    "@cloudflare/vite-plugin": "^1.54.2",
    "wrangler": "^4.127.1"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.2"
  }
}
